# Counted loop: taken branches, 1-bit predictor mispredictions, squash and recovery
Integer adder    4         1                              1
FP adder         3         3                              1
FP multiplier    2         5                              1
Load/store unit  4         1              3               1
ROB entries = 64
Issue width = 1
R1=12, R2=32, F20=3.0
Mem[4]=3.0, Mem[8]=2.0, Mem[12]=1.0, Mem[24]=6.0, Mem[28]=5.0, Mem[32]=4.0
Ld F2, 0(R1)
Mult.d F4, F2, F20
Ld F6, 0(R2)
Add.d F6, F4, F6
Sd F6, 0(R2)
Addi R1, R1, -4
Addi R2, R2, -4
Bne R1, R0, -8
Add.d F20, F2, F2
